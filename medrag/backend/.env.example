# Optional local HTTP proxy. Keep these empty when no proxy is required.
APP_VERSION=dev
BUILD_COMMIT=unknown

HTTP_PROXY=
HTTPS_PROXY=
http_proxy=
https_proxy=
NO_PROXY=localhost,127.0.0.1,api-inference.modelscope.cn,api.siliconflow.cn
no_proxy=localhost,127.0.0.1,api-inference.modelscope.cn,api.siliconflow.cn

REWRITE_LLM_PROVIDER=modelscope
REWRITE_LLM_API_KEY=your_rewrite_key
REWRITE_LLM_BASE_URL=https://api-inference.modelscope.cn/v1
REWRITE_LLM_MODEL=your_rewrite_model
REWRITE_LLM_TIMEOUT_SECONDS=20
REWRITE_LLM_MAX_RETRIES=0

ANSWER_LLM_PROVIDER=modelscope
ANSWER_LLM_API_KEY=your_answer_key
ANSWER_LLM_BASE_URL=https://api-inference.modelscope.cn/v1
ANSWER_LLM_MODEL=your_answer_model
ANSWER_LLM_TIMEOUT_SECONDS=120
ANSWER_LLM_MAX_RETRIES=1
RETRIEVAL_MODE=dense
# Leave empty until the threshold is calibrated on the evaluation dataset.
EVIDENCE_RERANK_MIN_SCORE=
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=your_siliconflow_key
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=2
VECTOR_WRITE_BATCH_SIZE=100
# Keep API-built vectors separate from local or other-provider indexes.
CHROMA_DIR=D:\MedRag\runtime\chroma_bge_m3_api
UPLOAD_DIR=your_upload_path
MONGODB_URI=your_mongodb_uri
MONGODB_DB_NAME=medrag
OCR_ENABLED=true
OCR_LANGUAGES=eng+chi_sim
OCR_DPI=300
OCR_MIN_TEXT_CHARS=20
TESSDATA_PREFIX=your_tessdata_path
MAX_UPLOAD_SIZE_MB=20
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
SUMMARY_SEED_K=5
SUMMARY_SUBQUERY_RETRIEVE_K=10
SUMMARY_SUBQUERY_KEEP_K=3
SUMMARY_CONTEXT_K=10
SUMMARY_MAX_SUBQUERIES=6
