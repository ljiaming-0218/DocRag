OPENROUTER_API_KEY=your_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=your_model
RETRIEVAL_MODE=dense
# Leave empty until the threshold is calibrated on the evaluation dataset.
EVIDENCE_RERANK_MIN_SCORE=
EMBEDDING_BATCH_SIZE=32
VECTOR_WRITE_BATCH_SIZE=100
CHROMA_DIR=your_chroma_path
UPLOAD_DIR=your_upload_path
MONGODB_URI=your_mongodb_uri
MONGODB_DB_NAME=medrag
OCR_ENABLED=true
OCR_LANGUAGES=eng+chi_sim
OCR_DPI=300
OCR_MIN_TEXT_CHARS=20
TESSDATA_PREFIX=your_tessdata_path
MAX_UPLOAD_SIZE_MB=20
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60